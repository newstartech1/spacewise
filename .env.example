# Example variable names only. Set credentials in your terminal session; do not put keys in files.

# For Amazon Bedrock API-key authentication, set this only in the terminal
# that starts FastAPI (or in an untracked local .env file). Never commit a key.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Gemini is optional. When needed, set GEMINI_API_KEY and GEMINI_MODEL in the terminal.
