# Example variable names only. Set credentials in your terminal session; do not put keys in files.

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
SPACEWISE_S3_BUCKET=your_existing_spacewise_bucket_name
AWS_REKOGNITION_COLLECTION_ID=spacewise-local-placeholder

# Gemini is optional. When needed, set GEMINI_API_KEY and GEMINI_MODEL in the terminal.
